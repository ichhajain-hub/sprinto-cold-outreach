# Copy to .env and fill in. Keep .env out of git.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_EXTRACT=
GEMINI_MODEL_QUALIFY=
GEMINI_MODEL_PAIN=
GEMINI_MODEL_EMAIL=
HUNTER_API_KEY=your-hunter-key
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=                             # blank => uses onboarding@resend.dev
TO_EMAIL=you@wherever.com               # must match the email your Resend account is registered with when FROM_EMAIL is blank
